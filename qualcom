    if networking then
        for _, name in ipairs({
            "RF/HalloweenDimension/AskDropEgg",
            "RF/HalloweenDimension/DropEgg",
            "RE/HalloweenDimension/AskDropEgg",
            "RE/HalloweenDimension/DropEgg"
        }) do
            local r = networking:FindFirstChild(name)
            if r then
                self.CachedDropRemote = r
                return r
            end
        end
        for _, child in ipairs(networking:GetChildren()) do
            if (child:IsA("RemoteFunction") or child:IsA("RemoteEvent")) and string.find(child.Name, "HalloweenDimension", 1, true) and string.find(string.lower(child.Name), "drop", 1, true) then
                self.CachedDropRemote = child
                return child
            end
        end
    end
    return nil
end

function HalloweenStealManager:DropEgg()
    if not isHoldingEgg() then return true end

    -- 1. Try HalloweenDimension specific drop remote if present
    local dropRemote = self:GetDropRemote()
    if dropRemote then
        if dropRemote:IsA("RemoteFunction") then
            pcall(function() dropRemote:InvokeServer({ Reason = "PlayerRequest" }) end)
            if isHoldingEgg() then
                pcall(function() dropRemote:InvokeServer() end)
            end
        elseif dropRemote:IsA("RemoteEvent") then
            pcall(function() dropRemote:FireServer({ Reason = "PlayerRequest" }) end)
            pcall(function() dropRemote:FireServer() end)
        end
    end

    -- 2. Try standard AskFieldEggDrop / EggState.DropFieldEgg
    if isHoldingEgg() then
        dropHeldEggDirect()
    end

    -- 3. Try firing the Drop GUI button if still holding
    if isHoldingEgg() then
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "SyntaxHubGUI" then
                local btn = gui:FindFirstChild("Drop", true) or (gui.Name == "DropHeldEgg" and gui:FindFirstChildWhichIsA("GuiButton", true))
                if btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) then
                    UniversalCompat.ClickButton(btn)
                end
            end
        end
    end

    local deadline = os.clock() + 0.45
    while os.clock() < deadline and isHoldingEgg() do
        Services.RunService.Heartbeat:Wait()
    end
    return not isHoldingEgg()
end

function HalloweenStealManager:RegrabAtGate(uid, targetEgg, entrancePos, session)
    if isHoldingEgg() then return true end
    local carryRemote = self:GetCarryRemote()
    local dim = Services.Workspace:FindFirstChild("HalloweenDimension", true)
    local folder = dim and dim:FindFirstChild("WorldEggs")

    local deadline = os.clock() + 0.85
    while os.clock() < deadline and not isHoldingEgg() do
        if session ~= self.CurrentSession or not isHalloweenStealEnabled() then break end

        local _, cRoot = getAliveRig()
        if cRoot then
            cRoot.CFrame = CFrame.new(entrancePos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
            cRoot.AssemblyLinearVelocity = Vector3.zero
        end

        if carryRemote and uid then
            pcall(function() carryRemote:InvokeServer(tostring(uid)) end)
        end

        if not isHoldingEgg() then
            local candidate = (targetEgg and targetEgg.Parent) and targetEgg or nil
            if not candidate and folder then
                local bestDist = 40
                for _, egg in ipairs(folder:GetChildren()) do
                    if egg:IsA("Model") or egg:IsA("BasePart") then
                        local eUid = egg:GetAttribute("HalloweenEggUid") or egg:GetAttribute("Uid") or egg:GetAttribute("EggUid")
                        if uid and tostring(eUid) == tostring(uid) then
                            candidate = egg
                            break
                        end
                        local pos = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
                        local d = (pos - entrancePos).Magnitude
                        if d < bestDist then
                            bestDist = d
                            candidate = egg
                        end
                    end
                end
            end
            if candidate then
                self:GrabEgg(candidate)
            end
        end

        if isHoldingEgg() then break end
        task.wait(0.05)
    end
    return isHoldingEgg()
end

function HalloweenStealManager:GetBarrierPart()
    if self.CachedBarrier and self.CachedBarrier.Parent then
        return self.CachedBarrier
    end
    local dim = Services.Workspace:FindFirstChild("HalloweenDimension", true)
    if dim then
        local nightWall = dim:FindFirstChild("NightWall", true)
        if nightWall then
            local barrier = nightWall:FindFirstChild("Barrier") or nightWall:FindFirstChildWhichIsA("BasePart")
            if barrier then
                self.CachedBarrier = barrier
                return barrier
            end
        end
    end
    return nil
end

function HalloweenStealManager:SelectTargetEgg()
    local dim = Services.Workspace:FindFirstChild("HalloweenDimension", true)
    local folder = dim and dim:FindFirstChild("WorldEggs")
    if not folder then return nil end

    -- Steal Panel Specific Halloween Egg Target
    if isHalloweenStealPanelTarget() then
        if State.targetedSpecificHalloweenEgg and State.targetedSpecificHalloweenEgg.Parent == folder then
            return State.targetedSpecificHalloweenEgg
        end
        for _, egg in ipairs(folder:GetChildren()) do
            if egg:IsA("Model") or egg:IsA("BasePart") then
                local uid = tostring(egg:GetAttribute("HalloweenEggUid") or egg:GetAttribute("Uid") or egg:GetAttribute("EggUid") or egg.Name)
                if uid == tostring(State.targetedSpecificUid) then
                    State.targetedSpecificHalloweenEgg = egg
                    return egg
                end
            end
        end
        if not self.IsActive and not isHoldingEgg() then
            if State.activeStealButtons[State.targetedSpecificUid] then
                State.activeStealButtons[State.targetedSpecificUid].BackgroundColor3 = activeTheme and activeTheme.Accent or Color3.fromRGB(92, 170, 255)
                State.activeStealButtons[State.targetedSpecificUid].Text = "Steal"
            end
            State.targetedSpecificUid = nil
            State.targetedSpecificIsHalloween = false
            State.targetedSpecificHalloweenEgg = nil
        end
        return nil
    end

    if not getgenv().config.autoHalloweenSteal then return nil end

    local _, root = getAliveRig()
    if not root then return nil end

    local targetAreas = getgenv().config.halloweenTargetAreas or currentSettings.HalloweenTargetAreas
    local minRarity = getgenv().config.halloweenMinRarity or currentSettings.HalloweenMinRarity or "All"

    local bestEgg = nil
    local bestScore = -math.huge

    for _, egg in ipairs(folder:GetChildren()) do
        if egg:IsA("Model") or egg:IsA("BasePart") then
            -- 1. Area Filter (Graveyard, Haunted Swamps, Abandoned Manor)
            local eggArea = HalloweenAreaManager:GetArea(egg)
            local areaAllowed = false
            if not targetAreas or targetAreas["All"] or next(targetAreas) == nil then
                areaAllowed = true
            elseif targetAreas[eggArea] == true then
                areaAllowed = true
            end

            if areaAllowed then
                -- 2. Rarity Filter (Meets minimum rarity rank)
                if DynamicRarityResolver:MeetsMinRarity(egg, minRarity) then
                    -- 3. Priority Scoring (Highest rank, scale & base value)
                    local score = DynamicRarityResolver:GetEggScore(egg)
                    local pivot = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
                    local dist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(pivot.X, 0, pivot.Z)).Magnitude

                    -- Tie-breaker: prefer closer egg if score is identical
                    local finalScore = score - (dist * 0.1)

                    if finalScore > bestScore then
                        bestScore = finalScore
                        bestEgg = egg
                    end
                end
            end
        end
    end
    return bestEgg
end

function HalloweenStealManager:GrabEgg(targetEgg)
    if not targetEgg or not targetEgg.Parent then return false end
    local uid = targetEgg:GetAttribute("HalloweenEggUid") 
             or targetEgg:GetAttribute("Uid") 
             or targetEgg:GetAttribute("EggUid")

    local carryRemote = self:GetCarryRemote()
    if carryRemote and uid then
        pcall(function() carryRemote:InvokeServer(tostring(uid)) end)
    end

    if isHoldingEgg() then return true end

    local prompt = targetEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled then
        UniversalCompat.FireProximityPrompt(prompt)
    end

    local deadline = os.clock() + 0.35
    while os.clock() < deadline and not isHoldingEgg() do
        Services.RunService.Heartbeat:Wait()
    end
    return isHoldingEgg()
end

function HalloweenStealManager:ExecuteDelivery(session, uid, targetEgg)
    local char, root, hum = getAliveRig()
    if not root or not hum then return false end

    uid = uid or self.LastGrabbedUid
    targetEgg = targetEgg or self.LastGrabbedEgg

    ShieldManager:MuteUGI()

    local barrier = self:GetBarrierPart()
    local entrancePos = self.GateEntrancePos
    local safePadPos = self.InsideSafePadPos

    if barrier then
        entrancePos = Vector3.new(barrier.Position.X, self.GateEntrancePos.Y, barrier.Position.Z + 14)
        safePadPos = Vector3.new(barrier.Position.X, self.InsideSafePadPos.Y, barrier.Position.Z - 30)
    end

    -- 1. Immediately TP to the barrier checkpoint
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(entrancePos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
    task.wait(0.08)

    if session ~= self.CurrentSession or not isHalloweenStealEnabled() then
        ShieldManager:UnmuteUGI()
        return false
    end

    -- 2. Drop the egg at the barrier checkpoint and immediately regrab it to reset server carry distance
    self:DropEgg()
    task.wait(0.06)
    self:RegrabAtGate(uid, targetEgg, entrancePos, session)

    -- 3. Wait briefly at the barrier checkpoint before tweening across to deliver
    local waitStart = os.clock()
    while os.clock() - waitStart < self.DeliveryDelay do
        if session ~= self.CurrentSession or not isHalloweenStealEnabled() or not isHoldingEgg() then
            ShieldManager:UnmuteUGI()
            return false
        end
        local _, cRoot = getAliveRig()
        if cRoot then
            cRoot.CFrame = CFrame.new(entrancePos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
            cRoot.AssemblyLinearVelocity = Vector3.zero
        end
        Services.RunService.Heartbeat:Wait()
    end

    -- 4. Tween across the barrier into the delivery pad
    local _, finalRoot, finalHum = getAliveRig()
    if not finalRoot or not finalHum then
        ShieldManager:UnmuteUGI()
        return false
    end

    finalHum.PlatformStand = true
    local tweenInfo = TweenInfo.new(self.GateCrossDuration, Enum.EasingStyle.Linear)
    local tween = Services.TweenService:Create(finalRoot, tweenInfo, {
        CFrame = CFrame.new(safePadPos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
    })
    self.ActiveTween = tween
    tween:Play()
    tween.Completed:Wait()
    self.ActiveTween = nil

    finalHum.PlatformStand = false
    finalRoot.AssemblyLinearVelocity = Vector3.zero
    setCollisions(true)

    local deadline = os.clock() + self.SecureTimeout
    while os.clock() < deadline and isHoldingEgg() do
        Services.RunService.Heartbeat:Wait()
    end

    ShieldManager:UnmuteUGI()
    return not isHoldingEgg()
end

function HalloweenStealManager:Process()
    if not isHalloweenStealEnabled() then return end
    if self.IsActive then return end

    if not HalloweenPortalManager.IsInHalloweenDimension() then
        HalloweenPortalManager.EnterDimension(5.0)
        return
    end

    local char, root, hum = getAliveRig()
    if not char or not root or not hum then return end

    self.IsActive = true
    self.CurrentSession = self.CurrentSession + 1
    local session = self.CurrentSession

    if isHoldingEgg() then
        local delivered = self:ExecuteDelivery(session, self.LastGrabbedUid, self.LastGrabbedEgg)
        if delivered and isHalloweenStealPanelTarget() then
            local tUid = State.targetedSpecificUid
            if tUid and State.activeStealButtons[tUid] then
                State.activeStealButtons[tUid].BackgroundColor3 = activeTheme and activeTheme.Accent or Color3.fromRGB(92, 170, 255)
                State.activeStealButtons[tUid].Text = "Steal"
            end
            State.targetedSpecificUid = nil
            State.targetedSpecificIsHalloween = false
            State.targetedSpecificHalloweenEgg = nil
        end
    else
        local targetEgg = self:SelectTargetEgg()
        if targetEgg and targetEgg.Parent then
            local targetUid = tostring(targetEgg:GetAttribute("HalloweenEggUid") or targetEgg:GetAttribute("Uid") or targetEgg:GetAttribute("EggUid") or targetEgg.Name)
            local eggPos = targetEgg:IsA("Model") and targetEgg:GetPivot().Position or targetEgg.Position

            self.LastGrabbedUid = targetUid
            self.LastGrabbedEgg = targetEgg

            -- 1. TP directly onto the egg
            local _, curRoot = getAliveRig()
            if curRoot then
                curRoot.AssemblyLinearVelocity = Vector3.zero
                curRoot.AssemblyAngularVelocity = Vector3.zero
                curRoot.CFrame = CFrame.new(Vector3.new(eggPos.X, eggPos.Y + 1.2, eggPos.Z))
                task.wait(0.06)
            end

            -- 2. Grab the egg
            local grabbed = self:GrabEgg(targetEgg)
            if not grabbed then
                task.wait(0.1)
                grabbed = self:GrabEgg(targetEgg)
            end

            -- 3. TP to barrier checkpoint -> Drop & Regrab -> Deliver
            local delivered = false
            if (grabbed or isHoldingEgg()) and session == self.CurrentSession and isHalloweenStealEnabled() then
                delivered = self:ExecuteDelivery(session, targetUid, targetEgg)
            end

            if isHalloweenStealPanelTarget() and State.targetedSpecificUid == targetUid and (delivered or not targetEgg.Parent) then
                if State.activeStealButtons[targetUid] then
                    State.activeStealButtons[targetUid].BackgroundColor3 = activeTheme and activeTheme.Accent or Color3.fromRGB(92, 170, 255)
                    State.activeStealButtons[targetUid].Text = "Steal"
                end
                State.targetedSpecificUid = nil
                State.targetedSpecificIsHalloween = false
                State.targetedSpecificHalloweenEgg = nil
            end
        end
    end
    setCollisions(true)
    self.IsActive = false
end

function HalloweenStealManager:Abort()
    self.CurrentSession = self.CurrentSession + 1
    self.IsActive = false
    if self.ActiveTween then
        pcall(function() self.ActiveTween:Cancel() end)
        self.ActiveTween = nil
    end
    ShieldManager:UnmuteUGI()
    setCollisions(true)
    if PriorityManager then PriorityManager:Release("HalloweenSteal") end
    local _, root, hum = getAliveRig()
    if hum then hum.PlatformStand = false end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

