local function getStandingPosition(basePos)
    local _, root, hum = getAliveRig()
    local hipHeight = hum and hum.HipHeight or 2
    local rootSizeY = root and (root.Size.Y / 2) or 1
    return Vector3.new(basePos.X, basePos.Y + hipHeight + rootSizeY, basePos.Z)
end

local function runAlongGroundToEgg(targetPos, speed, sessionId, targetUid)
    local char, root, hum = getAliveRig()
    if not root or not hum then return false end

    setCollisions(false)
    local targetStandPos = getStandingPosition(targetPos)
    local delta = Vector3.new(targetStandPos.X - root.Position.X, 0, targetStandPos.Z - root.Position.Z)
    local timeout = os.clock() + math.max(10, (delta.Magnitude / speed) + 4)
    local arrived = false
    local lastLiveCheck = 0

    local conn
    conn = Services.RunService.Heartbeat:Connect(function(dt)
        if sessionId ~= State.currentStealSession or not isStealEnabled() or isMapClosed() then
            if conn then conn:Disconnect() conn = nil end
            return
        end

        local _, cRoot = getAliveRig()
        if not cRoot or os.clock() > timeout then
            if conn then conn:Disconnect() conn = nil end
            return
        end

        if targetUid and (os.clock() - lastLiveCheck >= 0.25) then
            lastLiveCheck = os.clock()
            if not isEggStillValid(targetUid) then
                blacklistEgg(targetUid, 15)
                if conn then conn:Disconnect() conn = nil end
                return
            end
        end

        local flatDiff = Vector3.new(targetStandPos.X - cRoot.Position.X, 0, targetStandPos.Z - cRoot.Position.Z)
        if flatDiff.Magnitude <= 3.5 then
            arrived = true
            cRoot.CFrame = CFrame.lookAt(targetStandPos, targetPos)
            cRoot.AssemblyLinearVelocity = Vector3.zero
            cRoot.AssemblyAngularVelocity = Vector3.zero
            if conn then conn:Disconnect() conn = nil end
            return
        end

        local dir = flatDiff.Unit
        local moveStep = math.min(speed * dt, flatDiff.Magnitude)
        cRoot.AssemblyLinearVelocity = Vector3.new(dir.X * speed, cRoot.AssemblyLinearVelocity.Y, dir.Z * speed)
        cRoot.CFrame = CFrame.new(cRoot.Position + dir * moveStep, targetStandPos)
    end)

    while conn and conn.Connected do
        Services.RunService.Heartbeat:Wait()
    end

    local _, fRoot = getAliveRig()
    if fRoot then
        fRoot.CFrame = CFrame.lookAt(targetStandPos, targetPos)
        fRoot.AssemblyLinearVelocity = Vector3.zero
        fRoot.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.05)
    return arrived and (sessionId == State.currentStealSession) and isStealEnabled()
end

local function getGroundY(x, z, fallbackY)
    fallbackY = fallbackY or (CONFIG.GroundAltitude + 2.85)
    local origin = Vector3.new(x, 150, z)
    local rayDir = Vector3.new(0, -200, 0)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {}
    if LocalPlayer.Character then
        table.insert(filterList, LocalPlayer.Character)
    end
    rayParams.FilterDescendantsInstances = filterList
    rayParams.IgnoreWater = true
    local result = Services.Workspace:Raycast(origin, rayDir, rayParams)
    if result and result.Position then
        return result.Position.Y + 2.85
    end
    return fallbackY
end

local function executeFastStealOutbound(targetPos, sessionId, targetUid)
    local world = Services.Workspace:FindFirstChild("World") or Services.Workspace:FindFirstChild("__OBJECTS")
    local build = world and world:FindFirstChild("Build")
    local portals = build and build:FindFirstChild("FuseBiomeLanePortals")
    local entrance = portals and portals:FindFirstChildWhichIsA("BasePart")
    local zone = build and build:FindFirstChild("FuseBiomeZone")
    local exitPart = zone and zone:FindFirstChild("ExitPart", true)

    if not entrance or not exitPart then
        return runAlongGroundToEgg(targetPos, CONFIG.FastStealGroundSpeed, sessionId, targetUid)
    end

    local _, root = getAliveRig()
    if not root then return false end

    root.CFrame = CFrame.new(CONFIG.BaseDropPosition)
    root.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.12)

    local inSky = false
    local entranceTimeout = os.clock() + 4.0

    while os.clock() < entranceTimeout do
        if sessionId ~= State.currentStealSession or not isStealEnabled() then return false end
        local _, cRoot = getAliveRig()
        if not cRoot then return false end

        cRoot.CFrame = CFrame.new(entrance.Position)
        cRoot.AssemblyLinearVelocity = Vector3.zero
        if typeof(firetouchinterest) == "function" then
            pcall(firetouchinterest, cRoot, entrance, 0)
            task.wait(0.02)
            pcall(firetouchinterest, cRoot, entrance, 1)
        end

        if cRoot.Position.Y > 10000 then
            inSky = true
            break
        end
        Services.RunService.Heartbeat:Wait()
    end

    if not inSky then
        return runAlongGroundToEgg(targetPos, CONFIG.FastStealGroundSpeed, sessionId, targetUid)
    end

    local exitTimeout = os.clock() + 4.0
    local leftSky = false

    while os.clock() < exitTimeout do
        if sessionId ~= State.currentStealSession or not isStealEnabled() then return false end
        local _, cRoot = getAliveRig()
        if not cRoot then return false end

        cRoot.CFrame = CFrame.new(exitPart.Position)
        cRoot.AssemblyLinearVelocity = Vector3.zero
        if typeof(firetouchinterest) == "function" then
            pcall(firetouchinterest, cRoot, exitPart, 0)
            task.wait(0.02)
            pcall(firetouchinterest, cRoot, exitPart, 1)
        end

        if cRoot.Position.Y < 500 then
            leftSky = true
            break
        end
        Services.RunService.Heartbeat:Wait()
    end

    if not leftSky then
        return runAlongGroundToEgg(targetPos, CONFIG.FastStealGroundSpeed, sessionId, targetUid)
    end

    local _, fRoot = getAliveRig()
    if fRoot then
        local gY = getGroundY(targetPos.X, targetPos.Z, CONFIG.GroundAltitude + 2.85)
        fRoot.CFrame = CFrame.new(targetPos.X, gY, targetPos.Z)
        fRoot.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.08)
    end

    return true
end

local function findMyPlot()
    if State.myPlot and State.myPlot.Parent and State.myTreadmill and State.myTreadmill.Parent then
        return State.myPlot
    end

    local plotContainers = {
        Services.Workspace:FindFirstChild("Plots"),
        Services.Workspace:FindFirstChild("World") and Services.Workspace.World:FindFirstChild("Plots"),
        Services.Workspace:FindFirstChild("__OBJECTS") and Services.Workspace.__OBJECTS:FindFirstChild("Plots")
    }

    local myName = LocalPlayer.Name
    local myUserId = LocalPlayer.UserId

    for _, container in ipairs(plotContainers) do
        if container then
            for _, plot in ipairs(container:GetChildren()) do
                local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player") or plot:FindFirstChild("OwnerId") or plot:FindFirstChild("UserId")
                local isMine = false

                if ownerVal then
                    if (ownerVal:IsA("ObjectValue") and ownerVal.Value == LocalPlayer) or
                       (ownerVal:IsA("StringValue") and (ownerVal.Value == myName or ownerVal.Value == tostring(myUserId))) or
                       (ownerVal:IsA("IntValue") and ownerVal.Value == myUserId) then
                        isMine = true
                    end
                elseif plot.Name == myName or plot.Name == tostring(myUserId) then
                    isMine = true
                elseif plot:GetAttribute("Owner") == myName or plot:GetAttribute("UserId") == myUserId then
                    isMine = true
                end

                if isMine then
                    State.myPlot = plot
                    local objects = plot:FindFirstChild("Objects") or plot:FindFirstChild("Build") or plot
                    State.myTreadmill = objects:FindFirstChild("Treadmill", true) or plot:FindFirstChild("Treadmill", true)
                    return plot
                end
            end
        end
    end
    return nil
end

