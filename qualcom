-- [ HALLOWEEN AUTO-STEAL MANAGER - DIRECT REMOTE & GATE TWEEN ]
-- ==============================================================================
HalloweenStealManager = {
    IsActive = false,
    CurrentSession = 0,
    CachedCarryRemote = nil,
    CachedBarrier = nil,
    GateEntrancePos = Vector3.new(-5811.0, -203.6, -7296.0),
    InsideSafePadPos = Vector3.new(-5810.3, -200.1, -7342.9),
    DeliveryDelay = 2.5,
    GateCrossDuration = 0.35,
    SecureTimeout = 3.5,
    ThreadRunning = false
}

function HalloweenStealManager:GetCarryRemote()
    if self.CachedCarryRemote and self.CachedCarryRemote.Parent then
        return self.CachedCarryRemote
    end
    local packages = Services.ReplicatedStorage:FindFirstChild("Packages")
    local networking = packages and packages:FindFirstChild("Networking")
    if networking then
        local remote = networking:FindFirstChild("RF/HalloweenDimension/AskCarryEgg")
        if remote then
            self.CachedCarryRemote = remote
            return remote
        end
    end
    for _, desc in ipairs(Services.ReplicatedStorage:GetDescendants()) do
        if desc:IsA("RemoteFunction") and desc.Name == "RF/HalloweenDimension/AskCarryEgg" then
            self.CachedCarryRemote = desc
            return desc
        end
    end
    return nil
end

function HalloweenStealManager:GetBarrierPart()
    if self.CachedBarrier and self.CachedBarrier.Parent then
        return self.CachedBarrier
    end
    local dim = Services.Workspace:FindFirstChild("HalloweenDimension", true)
    if dim then
        local nightWall = dim:FindFirstChild("NightWall", true)
        if nightWall then
            local barrier = nightWall:FindFirstChild("Barrier") or nightWall:FindFirstChildWhichIsA("BasePart")
            if barrier then
                self.CachedBarrier = barrier
                return barrier
            end
        end
        for _, desc in ipairs(dim:GetDescendants()) do
            if desc:IsA("BasePart") and desc.Name == "Barrier" then
                self.CachedBarrier = desc
                return desc
            end
        end
    end
    return nil
end

function HalloweenStealManager:SelectTargetEgg()
    local dim = Services.Workspace:FindFirstChild("HalloweenDimension", true)
    local folder = dim and dim:FindFirstChild("WorldEggs")
    if not folder then return nil end

    local _, root = getAliveRig()
    if not root then return nil end

    local bestEgg = nil
    local shortestDist = math.huge

    for _, egg in ipairs(folder:GetChildren()) do
        if egg:IsA("Model") or egg:IsA("BasePart") then
            local pivot = egg:GetPivot().Position
            local dist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(pivot.X, 0, pivot.Z)).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                bestEgg = egg
            end
        end
    end
    return bestEgg
end

function HalloweenStealManager:IsHoldingHalloweenEgg()
    local dropGui = PlayerGui:FindFirstChild("DropHeldEgg")
    local runGui = PlayerGui:FindFirstChild("RunBackEffects")
    if (dropGui and dropGui:IsA("ScreenGui") and dropGui.Enabled) or 
       (runGui and runGui:IsA("ScreenGui") and runGui.Enabled) then
        return true
    end

    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "HalloweenDirectGrabGUI" and gui.Name ~= "SyntaxHubGUI" and gui.Name ~= "SyntaxHub" then
            local btn = gui:FindFirstChild("Drop", true)
            if btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) then
                return true
            end
        end
    end
    return false
end

function HalloweenStealManager:GrabEgg(targetEgg)
    if not targetEgg or not targetEgg.Parent then return false end
    local uid = targetEgg:GetAttribute("HalloweenEggUid") 
             or targetEgg:GetAttribute("Uid") 
             or targetEgg:GetAttribute("EggUid")

    local carryRemote = self:GetCarryRemote()
    if carryRemote and uid then
        pcall(function() carryRemote:InvokeServer(tostring(uid)) end)
    end

    if self:IsHoldingHalloweenEgg() then return true end

    local prompt = targetEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled then
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 30
        prompt.HoldDuration = 0
        if typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt, 0)
        else
            prompt:InputHoldBegin()
            prompt:InputHoldEnd()
        end
    end

    local deadline = os.clock() + 0.35
    while os.clock() < deadline and not self:IsHoldingHalloweenEgg() do
        Services.RunService.Heartbeat:Wait()
    end
    return self:IsHoldingHalloweenEgg()
end

function HalloweenStealManager:ExecuteDelivery(session)
    local char, root, hum = getAliveRig()
    if not root or not hum then return false end

    ShieldManager:MuteUGI()

    local barrier = self:GetBarrierPart()
    local entrancePos = self.GateEntrancePos
    local safePadPos = self.InsideSafePadPos

    if barrier then
        entrancePos = Vector3.new(barrier.Position.X, self.GateEntrancePos.Y, barrier.Position.Z + 14)
        safePadPos = Vector3.new(barrier.Position.X, self.InsideSafePadPos.Y, barrier.Position.Z - 30)
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(entrancePos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))

    local waitStart = os.clock()
    while os.clock() - waitStart < self.DeliveryDelay do
        if session ~= self.CurrentSession or (not getgenv().config.autoHalloweenSteal and not getgenv().AutoHalloweenSteal) or not self:IsHoldingHalloweenEgg() then
            ShieldManager:UnmuteUGI()
            return false
        end
        root.CFrame = CFrame.new(entrancePos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
        root.AssemblyLinearVelocity = Vector3.zero
        Services.RunService.Heartbeat:Wait()
    end

    hum.PlatformStand = false
    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
    local tweenInfo = TweenInfo.new(self.GateCrossDuration, Enum.EasingStyle.Linear)
    local tween = Services.TweenService:Create(root, tweenInfo, {
        CFrame = CFrame.new(safePadPos) * CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
    })
    tween:Play()

    if barrier and typeof(firetouchinterest) == "function" then
        pcall(firetouchinterest, root, barrier, 0)
        task.wait(0.02)
        pcall(firetouchinterest, root, barrier, 1)
    end

    tween.Completed:Wait()
    hum.PlatformStand = false
    root.AssemblyLinearVelocity = Vector3.zero

    local deadline = os.clock() + self.SecureTimeout
    while os.clock() < deadline and self:IsHoldingHalloweenEgg() do
        Services.RunService.Heartbeat:Wait()
    end

    ShieldManager:UnmuteUGI()
    return not self:IsHoldingHalloweenEgg()
end

function HalloweenStealManager:Start()
    if self.ThreadRunning then return end
    self.ThreadRunning = true
    task.spawn(function()
        while getgenv().config.autoHalloweenSteal or getgenv().AutoHalloweenSteal do
            if PriorityManager and not PriorityManager:CanRun("HalloweenSteal") then
                Services.RunService.Heartbeat:Wait()
            else

            local inDimension = HalloweenPortalManager.IsInHalloweenDimension()
            if not inDimension then
                HalloweenPortalManager.EnterDimension(3.0)
                task.wait(1.0)
            else
                local char, root, hum = getAliveRig()
                if char and root and hum and not self.IsActive then
                    applyGodMode(char)

                    if self:IsHoldingHalloweenEgg() then
                        self.IsActive = true
                        self.CurrentSession = self.CurrentSession + 1
                        local session = self.CurrentSession
                        self:ExecuteDelivery(session)
                        self.IsActive = false
                        task.wait(0.15)
                    else
                        local targetEgg = self:SelectTargetEgg()
                        if targetEgg and targetEgg.Parent then
                            self.IsActive = true
                            self.CurrentSession = self.CurrentSession + 1
                            local session = self.CurrentSession

                            local eggPos = targetEgg:GetPivot().Position
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.CFrame = CFrame.new(Vector3.new(eggPos.X, eggPos.Y + 1.2, eggPos.Z))
                            task.wait(0.04)

                            local grabbed = self:GrabEgg(targetEgg)
                            if not grabbed then
                                task.wait(0.1)
                                grabbed = self:GrabEgg(targetEgg)
                            end

                            if (grabbed or self:IsHoldingHalloweenEgg()) and session == self.CurrentSession then
                                self:ExecuteDelivery(session)
                            end

                            self.IsActive = false
                            task.wait(0.15)
                        else
                            task.wait(1.5)
                        end
                    end
                end
            end
            Services.RunService.Heartbeat:Wait()
            end
        end
        self.ThreadRunning = false
        self:Abort()
    end)
end

function HalloweenStealManager:Process()
    if not getgenv().config.autoHalloweenSteal and not getgenv().AutoHalloweenSteal then return end
    if not self.ThreadRunning then
        self:Start()
    end
end

function HalloweenStealManager:Abort()
    self.CurrentSession = self.CurrentSession + 1
    self.IsActive = false
    self.ThreadRunning = false
    ShieldManager:UnmuteUGI()
    if PriorityManager then PriorityManager:Release("HalloweenSteal") end
    local _, root, hum = getAliveRig()
    if hum then hum.PlatformStand = false end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

-- [ TASK PRIORITY ARBITRATOR ]
-- ==============================================================================
PriorityManager = {
    ActiveTask = nil,
    List = {
        "Auto Steal",
        "Halloween Steal",
        "Candy Cane Farm",
        "Bloom Event",
        "Auto Upgrades",
        "Auto Treadmill"
    },
    TaskAliases = {
        ["Steal"] = "Auto Steal",
        ["HalloweenSteal"] = "Halloween Steal",
        ["CandyCane"] = "Candy Cane Farm",
        ["Bloom"] = "Bloom Event",
        ["Upgrades"] = "Auto Upgrades",
        ["Treadmill"] = "Auto Treadmill"
    }
}

function PriorityManager:Initialize(savedPriorities)
    if type(savedPriorities) == "table" and #savedPriorities > 0 then
        local valid = {}
        for _, name in ipairs(self.List) do valid[name] = true end
        local newList = {}
        for _, name in ipairs(savedPriorities) do
            if valid[name] then
                table.insert(newList, name)
                valid[name] = nil
            end
        end
        for _, name in ipairs(self.List) do
            if valid[name] then table.insert(newList, name) end
        end
        self.List = newList
    end
end

function PriorityManager:GetRank(taskName)
    local resolved = self.TaskAliases[taskName] or taskName
    for index, name in ipairs(self.List) do
        if name == resolved then
            return index
        end
    end
    return 999
end

function PriorityManager:IsTaskEnabled(taskName)
    local resolved = self.TaskAliases[taskName] or taskName
    if resolved == "Auto Steal" then
        return isStealEnabled() and not isMapClosed()
    elseif resolved == "Halloween Steal" then
        return getgenv().config.autoHalloweenSteal == true
    elseif resolved == "Candy Cane Farm" then
        return getgenv().config.autoCandyCane == true
    elseif resolved == "Bloom Event" then
        return (getgenv().config.autoCatchButterfly == true or getgenv().config.autoWispQuest == true) and not isMapClosed()
    elseif resolved == "Auto Upgrades" then
        return (getgenv().config.autoUpgradeTreadmill == true or getgenv().config.autoUpgradeBase == true)
    elseif resolved == "Auto Treadmill" then
        return getgenv().config.autoTreadmill == true
    end
    return false
end

function PriorityManager:CanRun(taskName)
    local myRank = self:GetRank(taskName)
    local resolved = self.TaskAliases[taskName] or taskName

    -- If another task is actively claiming execution with higher priority, block
    if self.ActiveTask and self.ActiveTask ~= taskName and self.ActiveTask ~= resolved then
        local currentRank = self:GetRank(self.ActiveTask)
        if myRank > currentRank then
            return false
        end
    end

    -- If in Halloween dimension, main-world tasks (Steal, Treadmill, Bloom) cannot run
    if (resolved == "Auto Steal" or resolved == "Auto Treadmill" or resolved == "Bloom Event") then
        if HalloweenPortalManager and HalloweenPortalManager.IsInHalloweenDimension() then
            return false
        end
    end

    -- If any higher-priority task is actively busy / executing, block
    for i = 1, myRank - 1 do
        local higherTask = self.List[i]
        if higherTask and higherTask ~= resolved then
            if higherTask == "Auto Steal" and isStealEnabled() and (State.isStealingActive or isHoldingEgg()) then
                return false
            elseif higherTask == "Halloween Steal" and getgenv().config.autoHalloweenSteal and (HalloweenStealManager and HalloweenStealManager.IsActive) then
                return false
            elseif higherTask == "Candy Cane Farm" and getgenv().config.autoCandyCane and (HalloweenPortalManager and HalloweenPortalManager.IsInHalloweenDimension()) then
                return false
            elseif higherTask == "Bloom Event" and (BloomManager and BloomManager.IsBusy) then
                return false
            end
        end
    end

    return true
end

function PriorityManager:Claim(taskName)
    if self:CanRun(taskName) then
        self.ActiveTask = taskName
        return true
    end
    return false
end

function PriorityManager:Release(taskName)
    local resolved = self.TaskAliases[taskName] or taskName
    if self.ActiveTask == taskName or self.ActiveTask == resolved then
        self.ActiveTask = nil
    end
end

function PriorityManager:MoveUp(index, saveCallback)
    if index > 1 then
        local item = table.remove(self.List, index)
        table.insert(self.List, index - 1, item)
        if saveCallback then saveCallback(self.List) end
        return true
    end
    return false
end

function PriorityManager:MoveDown(index, saveCallback)
    if index < #self.List then
        local item = table.remove(self.List, index)
        table.insert(self.List, index + 1, item)
        if saveCallback then saveCallback(self.List) end
        return true
    end
    return false
end

