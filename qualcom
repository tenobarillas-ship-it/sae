local function applyTrans(val)
    val = math.clamp(val, 0, 100)
    local a = val / 100
    sldrUI.Txt.Text = "Transparency: " .. math.floor(val) .. "%"
    sldrUI.Fil.Size = UDim2.new(a, 0, 1, 0)
    sldrUI.Kn.Position = UDim2.new(a, -6, 0.5, -6)

    local function doT(inst)
        if inst:IsA("GuiObject") then
            if inst:GetAttribute("OrigBg") == nil then inst:SetAttribute("OrigBg", inst.BackgroundTransparency) end
            inst.BackgroundTransparency = inst:GetAttribute("OrigBg") + ((1 - inst:GetAttribute("OrigBg")) * (a * 0.90))
        end
        if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
            if inst:GetAttribute("OrigTxt") == nil then inst:SetAttribute("OrigTxt", inst.TextTransparency) end
            inst.TextTransparency = inst:GetAttribute("OrigTxt") + ((1 - inst:GetAttribute("OrigTxt")) * (a * 0.2))
        end
        if inst:IsA("UIStroke") then
            if inst:GetAttribute("OrigStr") == nil then inst:SetAttribute("OrigStr", inst.Transparency) end
            inst.Transparency = inst:GetAttribute("OrigStr") + ((1 - inst:GetAttribute("OrigStr")) * (a * 0.4))
        end
    end
    doT(frm)
    for _, child in ipairs(frm:GetDescendants()) do doT(child) end
end

sldrUI.Trk.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local function update(pos)
            local relX = math.clamp(pos.X - sldrUI.Trk.AbsolutePosition.X, 0, sldrUI.Trk.AbsoluteSize.X)
            local pct = (relX / sldrUI.Trk.AbsoluteSize.X) * 100
            applyTrans(pct)
        end
        update(input.Position)
        local conn
        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.Change then
                update(input.Position)
            elseif input.UserInputState == Enum.UserInputState.End then
                currentSettings.Transparency = math.clamp(tonumber(string.match(sldrUI.Txt.Text, "%d+")) or 0, 0, 100)
                saveStuff()
                conn:Disconnect()
            end
        end)
    end
end)

