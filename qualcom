    if getgenv().config.autoCraftEssence then
        local craftRemote = Remotes.CraftEssence or getRemote("RF/Butterflies/AskCraftEssence")
        if craftRemote then
            pcall(function() craftRemote:InvokeServer("MutationShrine") end)
        end
    end
end


