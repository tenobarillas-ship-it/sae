local renderStealPanel = nil

renderStealPanel = function()
    local savedCanvasY = spListScrl.CanvasPosition.Y
    for _, ch in ipairs(spListScrl:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    table.clear(State.activeStealButtons)

    local data = EggState and typeof(EggState.ReadFieldEggs) == "function" and EggState.ReadFieldEggs()
    if not data or not data.Records then return end

    if State.targetedSpecificUid and not isHoldingEgg() and not State.isStealingActive then
        local found = false
        for uid, record in pairs(data.Records) do
            if uid == State.targetedSpecificUid or record.Uid == State.targetedSpecificUid then
                found = true
                break
            end
        end
        if not found then State.targetedSpecificUid = nil end
    end

    local eggItems = {}
    for keyUid, record in pairs(data.Records) do
        local uid = record.Uid or keyUid
        record.Uid = uid
        if not isBlacklisted(uid) and (record.State == "Slot" or record.State == "Dropped" or record.State == nil) then
            local rawName = record.AssetCategory or record.Category or record.Name or "Unknown"
            local rarityName, rarityRank = MasterRegistry:Lookup(rawName)
            local pData = MasterRegistry.PetDatabase[rawName] or {}

            local scale = tonumber(record.AssetScale) or 1
            local factor = scale > 5 and ((scale / 5) ^ 1.2 * 19.637875755794113) or (scale ^ 1.85)
            local mutationBonus = (record.Mutations and #record.Mutations > 0) and 2.5 or 1
            local earningRate = tonumber(pData.EarningRate) or 0
            local valuePerSec = earningRate * factor * mutationBonus

            local iconId = tostring(pData.Icon or "")
            if iconId ~= "" and tonumber(iconId) then iconId = "rbxassetid://" .. iconId end

            table.insert(eggItems, {
                Uid = uid,
                Name = rawName,
                Area = tostring(record.AreaId or "Unknown"),
                Scale = scale,
                Rarity = rarityName,
                Rank = rarityRank,
                Value = valuePerSec,
                Icon = iconId,
                Record = record
            })
        end
    end

    table.sort(eggItems, function(a, b)
        if State.spSortChoice == "Value (Money/s)" then return a.Value > b.Value
        elseif State.spSortChoice == "Rarity" then
            if a.Rank ~= b.Rank then return a.Rank > b.Rank end
            return a.Value > b.Value
        elseif State.spSortChoice == "Weight (Scale)" then return a.Scale > b.Scale end
        return a.Value > b.Value
    end)

    for i, item in ipairs(eggItems) do
        local card = Instance.new("Frame", spListScrl)
        card.Size = UDim2.new(1, -6, 0, 48)
        card.BackgroundColor3 = activeTheme.CardBg
        card.BackgroundTransparency = 0.35
        card.BorderSizePixel = 0
        card.LayoutOrder = i
        rndCorner(card, 8)

        local cStr = Instance.new("UIStroke", card)
        cStr.Thickness = 1
        cStr.Color = activeTheme.Stroke
        cStr.Transparency = 0.5

        local img = Instance.new("ImageLabel", card)
        img.Size = UDim2.new(0, 36, 0, 36)
        img.Position = UDim2.new(0, 6, 0.5, -18)
        img.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
        img.BackgroundTransparency = 0.5
        img.BorderSizePixel = 0
        img.Image = item.Icon
        rndCorner(img, 6)

        local nameLbl = Instance.new("TextLabel", card)
        nameLbl.Size = UDim2.new(1, -140, 0, 18)
        nameLbl.Position = UDim2.new(0, 48, 0, 6)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 12
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.Text = string.format("%s [%s]", item.Name, item.Rarity)

        local subLbl = Instance.new("TextLabel", card)
        subLbl.Size = UDim2.new(1, -140, 0, 16)
        subLbl.Position = UDim2.new(0, 48, 0, 24)
        subLbl.BackgroundTransparency = 1
        subLbl.Font = Enum.Font.Gotham
        subLbl.TextSize = 10
        subLbl.TextColor3 = activeTheme.SubText
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.Text = string.format("%s  |  %.2fx  |  %s", formatMoneyPerSec(item.Value), item.Scale, item.Area)

        local actBtn = Instance.new("TextButton", card)
        actBtn.Size = UDim2.new(0, 78, 0, 28)
        actBtn.Position = UDim2.new(1, -84, 0.5, -14)
        actBtn.BorderSizePixel = 0
        actBtn.Font = Enum.Font.GothamBold
        actBtn.TextSize = 11
        rndCorner(actBtn, 6)
        attachTactileAnimation(actBtn)

        local isThisTarget = (State.targetedSpecificUid == item.Uid)
        actBtn.BackgroundColor3 = isThisTarget and Color3.fromRGB(220, 60, 60) or activeTheme.Accent
        actBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        actBtn.Text = isThisTarget and "Stop Steal" or "Steal"

        State.activeStealButtons[item.Uid] = actBtn

        actBtn.MouseButton1Click:Connect(function()
            if State.targetedSpecificUid == item.Uid then
                State.targetedSpecificUid = nil
                abortStealRoutine()
                actBtn.BackgroundColor3 = activeTheme.Accent
                actBtn.Text = "Steal"
            else
                if State.isStealingActive then
                    abortStealRoutine()
                end
                State.targetedSpecificUid = item.Uid
                State.blacklistedEggs[item.Uid] = nil
                for u, b in pairs(State.activeStealButtons) do
                    if u == item.Uid then
                        b.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
                        b.Text = "Stop Steal"
                    else
                        b.BackgroundColor3 = activeTheme.Accent
                        b.Text = "Steal"
                    end
                end
            end
        end)
    end
    spListScrl.CanvasPosition = Vector2.new(0, savedCanvasY)
end

