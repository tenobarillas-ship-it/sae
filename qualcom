function UniversalCompat.FireProximityPrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    
    pcall(function()
        prompt.RequiresLineOfSight = false
        if (prompt.MaxActivationDistance or 0) < 50 then
            prompt.MaxActivationDistance = 50
        end
        prompt.HoldDuration = 0
    end)

    -- Method A: Exploit C-closure fireproximityprompt (highest priority, 100% safe from VIM detection)
    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(fireproximityprompt, prompt, 0)
        if not ok then ok = pcall(fireproximityprompt, prompt, 1) end
        if not ok then ok = pcall(fireproximityprompt, prompt) end
        if ok then return true end
    end

    -- Method B: Engine input hold simulation
    local success = false
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.03)
        prompt:InputHoldEnd()
        success = true
    end)
    if success then return true end

    -- Method C: VirtualInputManager Key simulation fallback ONLY if Method A and B are unavailable
    if VIM and prompt.KeyboardKeyCode and prompt.KeyboardKeyCode ~= Enum.KeyCode.Unknown then
        pcall(function()
            VIM:SendKeyEvent(true, prompt.KeyboardKeyCode, false, game)
            task.wait(0.03)
            VIM:SendKeyEvent(false, prompt.KeyboardKeyCode, false, game)
            success = true
        end)
    end

    return success
end

function UniversalCompat.FireTouch(part1, part2)
    if not part1 or not part2 or not part1.Parent or not part2.Parent then return false end

    -- Method A: Exploit firetouchinterest C-closure
    if typeof(firetouchinterest) == "function" then
        pcall(firetouchinterest, part1, part2, 0)
        task.wait(0.01)
        pcall(firetouchinterest, part1, part2, 1)
    end

    -- Method B: Ensure physical touch properties are enabled
    pcall(function()
        if part1:IsA("BasePart") then part1.CanTouch = true end
        if part2:IsA("BasePart") then part2.CanTouch = true end
    end)

    return true
end

function UniversalCompat.ClickButton(btn)
    if not btn or not btn:IsA("GuiButton") then return false end

    -- Method A: firesignal
    if typeof(firesignal) == "function" then
        local ok = pcall(firesignal, btn.Activated)
        pcall(firesignal, btn.MouseButton1Click)
        if ok then return true end
    end

    -- Method B: getconnections
    local triggered = false
    if typeof(getconnections) == "function" then
        local ok1, conns1 = pcall(getconnections, btn.Activated)
        if ok1 and type(conns1) == "table" then
            for _, c in ipairs(conns1) do
                pcall(function()
                    if c.Fire then c:Fire() elseif c.Function then c.Function() end
                end)
                triggered = true
            end
        end
        local ok2, conns2 = pcall(getconnections, btn.MouseButton1Click)
        if ok2 and type(conns2) == "table" then
            for _, c in ipairs(conns2) do
                pcall(function()
                    if c.Fire then c:Fire() elseif c.Function then c.Function() end
                end)
                triggered = true
            end
        end
        if triggered then return true end
    end

    -- Method C: VirtualInputManager click ONLY as last resort
    if VIM then
        pcall(function()
            local absPos = btn.AbsolutePosition
            local absSize = btn.AbsoluteSize
            local cx = absPos.X + (absSize.X / 2)
            local cy = absPos.Y + (absSize.Y / 2)
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.02)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            triggered = true
        end)
    end

    return triggered
end

