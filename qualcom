local function createSlider(title, desc, min, max, defaultVal, increment, parent, order, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -4, 0, 52)
    row.BackgroundColor3 = activeTheme.RowBg
    row.BackgroundTransparency = 0.4
