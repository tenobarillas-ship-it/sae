HalloweenStealManager = {
    IsActive = false,
    CurrentSession = 0,
    StepSpeed = 40,
    InstantSteal = true,
    LastGrabbedUid = nil,
    LastGrabbedEgg = nil,
    ActiveTween = nil,
    BadEggs = {},
    KnownEggNames = {}
}

function HalloweenStealManager:GetHalloweenDimension()
    return Services.Workspace:FindFirstChild("HalloweenDimension", true)
end

function HalloweenStealManager:GetSafeZonePart()
    local dim = self:GetHalloweenDimension()
    if not dim then return nil end
    local zones = dim:FindFirstChild("Zones")
    local sz = zones and zones:FindFirstChild("SafeZone")
    if sz and sz:IsA("BasePart") then return sz end
    for _, desc in ipairs(dim:GetDescendants()) do
        if desc:IsA("BasePart") and (desc.Name == "SafeZone" or desc.Name == "Safe_Zone") then
            return desc
        end
    end
    return nil
end

function HalloweenStealManager:GetCarryRemote()
    local packages = Services.ReplicatedStorage:FindFirstChild("Packages")
    local networking = packages and packages:FindFirstChild("Networking")
    if networking then
        local remote = networking:FindFirstChild("RF/HalloweenDimension/AskCarryEgg")
        if remote then return remote end
    end
    return nil
end

function HalloweenStealManager:GetDropRemote()
    local packages = Services.ReplicatedStorage:FindFirstChild("Packages")
    local networking = packages and packages:FindFirstChild("Networking")
    if networking then
        local remote = networking:FindFirstChild("RF/HalloweenDimension/AskDropEgg")
        if remote then return remote end
    end
    return nil
end

function HalloweenStealManager:IsCarryingEgg()
    if LocalPlayer:GetAttribute("HalloweenCarrying") == true then
        return true
    end
    return isHoldingEgg()
end

function HalloweenStealManager:DropEgg()
    if not self:IsCarryingEgg() then return true end

    local dropRemote = self:GetDropRemote()
    if dropRemote then
        pcall(function() dropRemote:InvokeServer() end)
    end
    if self:IsCarryingEgg() then
        dropHeldEggDirect()
    end

    local deadline = os.clock() + 0.6
    while os.clock() < deadline and self:IsCarryingEgg() do
        Services.RunService.Heartbeat:Wait()
    end
    return not self:IsCarryingEgg()
end

function HalloweenStealManager:GetEggResolvedInfo(egg)
    if not egg then return "Mystery Egg", 1, 0, "Unknown" end
    local uid = egg:GetAttribute("HalloweenEggUid") or egg:GetAttribute("Uid") or egg.Name
    local prepName = egg:GetAttribute("PreparedSourceName")
    if uid and prepName then self.KnownEggNames[uid] = prepName end
    local lookupName = prepName or (uid and self.KnownEggNames[uid]) or egg.Name

    -- Match against HalloweenPets.Specs if available
    local specId = nil
    local hwSpecs = DynamicRarityResolver and DynamicRarityResolver.HalloweenSpecs
    if hwSpecs then
        if hwSpecs[lookupName] then
            specId = hwSpecs[lookupName].Id or lookupName
        else
            for sId, sData in pairs(hwSpecs) do
                if type(sData) == "table" and (sData.EggSource == lookupName or sData.EggModel == lookupName) then
                    specId = sData.Id or sId
                    break
                end
            end
        end
    end

    -- Query Assets directory with specId or lookupName
    local assetDir = DynamicRarityResolver and DynamicRarityResolver.AssetsDirectory
    if assetDir and specId and assetDir[specId] then
        local asset = assetDir[specId]
        local rarityName = "Unknown"
        local rank = 1
        local earningRate = tonumber(asset.EarningRate or asset.BaseValue) or 0
        if type(asset.Rarity) == "table" then
            rarityName = asset.Rarity.DisplayName or asset.Rarity._id or "Unknown"
            rank = tonumber(asset.Rarity.RarityNumber or asset.Rarity.Rank) or 1
        end
        return specId, rank, earningRate, rarityName
    end

    local rName, rank, value, dispName = DynamicRarityResolver:ResolveRarity(egg)
    return dispName or lookupName, rank, value, rName
end

function HalloweenStealManager:SelectTargetEgg()
    local dim = self:GetHalloweenDimension()
    local folder = dim and dim:FindFirstChild("WorldEggs")
    if not folder then return nil end

    -- Steal Panel Specific Halloween Egg Target
    if isHalloweenStealPanelTarget() then
        if State.targetedSpecificHalloweenEgg and State.targetedSpecificHalloweenEgg.Parent == folder then
            return State.targetedSpecificHalloweenEgg
        end
        for _, egg in ipairs(folder:GetChildren()) do
            if egg:IsA("Model") or egg:IsA("BasePart") then
                local uid = tostring(egg:GetAttribute("HalloweenEggUid") or egg:GetAttribute("Uid") or egg:GetAttribute("EggUid") or egg.Name)
                if uid == tostring(State.targetedSpecificUid) then
                    State.targetedSpecificHalloweenEgg = egg
                    return egg
                end
            end
        end
        if not self.IsActive and not self:IsCarryingEgg() then
            if State.activeStealButtons[State.targetedSpecificUid] then
                State.activeStealButtons[State.targetedSpecificUid].BackgroundColor3 = activeTheme and activeTheme.Accent or Color3.fromRGB(92, 170, 255)
                State.activeStealButtons[State.targetedSpecificUid].Text = "Steal"
            end
            State.targetedSpecificUid = nil
            State.targetedSpecificIsHalloween = false
            State.targetedSpecificHalloweenEgg = nil
        end
        return nil
    end

    if not isHalloweenStealEnabled() then return nil end

    local _, root = getAliveRig()
    if not root then return nil end

    local targetAreas = getgenv().config.halloweenTargetAreas or currentSettings.HalloweenTargetAreas
    local minRarity = getgenv().config.halloweenMinRarity or currentSettings.HalloweenMinRarity or "All"

    local bestEgg = nil
    local bestScore = -math.huge

    for _, egg in ipairs(folder:GetChildren()) do
        if egg:IsA("Model") or egg:IsA("BasePart") then
            -- Cooldown check
            local badUntil = self.BadEggs[egg] or 0
            if badUntil < os.clock() then
                local prompt = egg:FindFirstChild("StealPrompt", true)
                if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                    -- 1. Area Filter (Graveyard, Haunted Swamps, Abandoned Manor)
                    local eggArea = HalloweenAreaManager:GetArea(egg)
                    local areaAllowed = false
                    if not targetAreas or targetAreas["All"] or next(targetAreas) == nil then
                        areaAllowed = true
                    elseif targetAreas[eggArea] == true then
                        areaAllowed = true
                    end

                    if areaAllowed then
                        -- 2. Rarity Filter
                        if DynamicRarityResolver:MeetsMinRarity(egg, minRarity) then
                            -- 3. Scoring using rank, scale and distance
                            local eggName, rank, earningRate, rName = self:GetEggResolvedInfo(egg)
                            local scale = egg:IsA("Model") and egg:GetScale() or 1
                            local scaleFactor = (scale > 5.0) and ((scale / 5.0)^1.2 * 19.637875755794113) or (scale^1.85)
                            local score = (rank * 1000) + (scaleFactor * math.max(earningRate, 1))

                            local eggPivot = egg:IsA("Model") and egg:GetPivot().Position or egg.Position
                            local dist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(eggPivot.X, 0, eggPivot.Z)).Magnitude

                            local finalScore = score - (dist * 0.05)
                            if finalScore > bestScore then
                                bestScore = finalScore
                                bestEgg = egg
                            end
                        end
                    end
                end
            end
        end
    end
    return bestEgg
end

function HalloweenStealManager:ApproachAndGrab(targetEgg, session)
    if not targetEgg or not targetEgg.Parent then return false end
    local prompt = targetEgg:FindFirstChild("StealPrompt", true)
    if not prompt or not prompt.Enabled then return false end

    local char, root = getAliveRig()
    if not root then return false end

    local eggUid = targetEgg:GetAttribute("HalloweenEggUid") or targetEgg:GetAttribute("Uid") or targetEgg.Name
    self.LastGrabbedUid = eggUid
    self.LastGrabbedEgg = targetEgg

    local stepSpeed = tonumber(getgenv().config.halloweenStealSpeed or currentSettings.HalloweenStealSpeed) or 40
    local isInstant = (getgenv().config.instantHalloweenSteal ~= false and currentSettings.InstantHalloweenSteal ~= false)

    -- Try carry remote first
    local carryRemote = self:GetCarryRemote()
    if carryRemote and eggUid then
        pcall(function() carryRemote:InvokeServer(tostring(eggUid)) end)
    end
    if self:IsCarryingEgg() then return true end

    for attempt = 1, 3 do
        if session ~= self.CurrentSession or not isHalloweenStealEnabled() or not targetEgg.Parent or not prompt.Enabled or self:IsCarryingEgg() then
            break
        end

        local eggPos = targetEgg:IsA("Model") and targetEgg:GetPivot().Position or targetEgg.Position
        local targetCFrame = CFrame.new(eggPos + Vector3.new(0, 3, 0))

        if isInstant then
            local deadline = os.clock() + 3.0
            while os.clock() < deadline and session == self.CurrentSession and isHalloweenStealEnabled() and targetEgg.Parent and prompt.Enabled and not self:IsCarryingEgg() do
                local _, cRoot = getAliveRig()
                if not cRoot then break end
                local curEggPos = targetEgg:IsA("Model") and targetEgg:GetPivot().Position or targetEgg.Position
                local delta = (curEggPos + Vector3.new(0, 3, 0)) - cRoot.Position
                if delta.Magnitude < 3 then break end

                local step = delta.Unit * math.min(delta.Magnitude, stepSpeed)
                cRoot.CFrame = CFrame.new(cRoot.Position + step)
                cRoot.AssemblyLinearVelocity = Vector3.zero
                Services.RunService.Heartbeat:Wait()
            end
        end

        local _, curRoot = getAliveRig()
        if curRoot then
            curRoot.CFrame = targetCFrame
            curRoot.AssemblyLinearVelocity = Vector3.zero
        end

        -- Trigger prompt loop
        local promptDeadline = os.clock() + 3.5
        local lastPromptFire = 0
        while os.clock() < promptDeadline and session == self.CurrentSession and isHalloweenStealEnabled() and targetEgg.Parent and prompt.Enabled and not self:IsCarryingEgg() do
            local _, cRoot = getAliveRig()
            if cRoot then
                local curEggPos = targetEgg:IsA("Model") and targetEgg:GetPivot().Position or targetEgg.Position
                cRoot.CFrame = CFrame.new(curEggPos + Vector3.new(0, 3, 0))
                cRoot.AssemblyLinearVelocity = Vector3.zero
            end

            if os.clock() - lastPromptFire >= 0.1 then
                lastPromptFire = os.clock()
                UniversalCompat.FireProximityPrompt(prompt)
                if carryRemote and eggUid then
                    pcall(function() carryRemote:InvokeServer(tostring(eggUid)) end)
                end
            end
            Services.RunService.Heartbeat:Wait()
        end

        if self:IsCarryingEgg() then break end
        task.wait(0.1)
    end

    if not self:IsCarryingEgg() and targetEgg.Parent then
        self.BadEggs[targetEgg] = os.clock() + 30
    end

    return self:IsCarryingEgg()
end

function HalloweenStealManager:ExecuteDelivery(session, uid, targetEgg)
    local char, root, hum = getAliveRig()
    if not root or not hum then return false end

    uid = uid or self.LastGrabbedUid
    targetEgg = targetEgg or self.LastGrabbedEgg

    ShieldManager:MuteUGI()

    local safeZonePart = self:GetSafeZonePart()
    if not safeZonePart then
        ShieldManager:UnmuteUGI()
        return false
    end

    local stepSpeed = tonumber(getgenv().config.halloweenStealSpeed or currentSettings.HalloweenStealSpeed) or 40
    local isInstant = (getgenv().config.instantHalloweenSteal ~= false and currentSettings.InstantHalloweenSteal ~= false)
    local initialDelivered = LocalPlayer:GetAttribute("HalloweenDelivered")

    -- 1. Step to safe zone edge
    local rel = safeZonePart.CFrame:PointToObjectSpace(root.Position)
    local padX = safeZonePart.Size.X / 2 + 10
    local padZ = safeZonePart.Size.Z / 2 + 10
    local edgePos = safeZonePart.CFrame:PointToWorldSpace(Vector3.new(
        math.clamp(rel.X, -padX, padX),
        0,
        math.clamp(rel.Z, -padZ, padZ)
    ))

    if isInstant and self:IsCarryingEgg() then
        local stepDeadline = os.clock() + 15.0
        while os.clock() < stepDeadline and session == self.CurrentSession and isHalloweenStealEnabled() and self:IsCarryingEgg() do
            local _, cRoot = getAliveRig()
            if not cRoot then break end
            local delta = Vector3.new(edgePos.X, cRoot.Position.Y, edgePos.Z) - cRoot.Position
            if delta.Magnitude < 2 then break end

            local step = delta.Unit * math.min(delta.Magnitude, stepSpeed)
            cRoot.CFrame = CFrame.new(cRoot.Position + step)
            cRoot.AssemblyLinearVelocity = Vector3.zero
            Services.RunService.Heartbeat:Wait()
        end

        -- Check for anti-cheat rollback and re-step if pulled
        for attempt = 1, 4 do
            local waitDeadline = os.clock() + 0.8
            local pulledBack = false
            while session == self.CurrentSession and isHalloweenStealEnabled() and self:IsCarryingEgg() and os.clock() < waitDeadline do
                local _, cRoot = getAliveRig()
                if cRoot and (cRoot.Position - edgePos).Magnitude >= 100 then
                    pulledBack = true
                    break
                end
                Services.RunService.Heartbeat:Wait()
            end
            if not pulledBack then break end

            local reStepDeadline = os.clock() + 10.0
            while os.clock() < reStepDeadline and session == self.CurrentSession and isHalloweenStealEnabled() and self:IsCarryingEgg() do
                local _, cRoot = getAliveRig()
                if not cRoot then break end
                local delta = Vector3.new(edgePos.X, cRoot.Position.Y, edgePos.Z) - cRoot.Position
                if delta.Magnitude < 2 then break end
                cRoot.CFrame = CFrame.new(cRoot.Position + delta.Unit * math.min(delta.Magnitude, stepSpeed))
                cRoot.AssemblyLinearVelocity = Vector3.zero
                Services.RunService.Heartbeat:Wait()
            end
        end

        -- 2. Drop and Regrab at the edge to reset displacement accumulator
        self:DropEgg()
        task.wait(0.1)

        -- Regrab egg at edge
        local regrabDeadline = os.clock() + 3.0
        while os.clock() < regrabDeadline and session == self.CurrentSession and isHalloweenStealEnabled() and not self:IsCarryingEgg() do
            local dim = self:GetHalloweenDimension()
            local folder = dim and dim:FindFirstChild("WorldEggs")
            local candidateEgg = (targetEgg and targetEgg.Parent) and targetEgg or nil
            if not candidateEgg and folder then
                for _, egg in ipairs(folder:GetChildren()) do
                    local eUid = egg:GetAttribute("HalloweenEggUid") or egg:GetAttribute("Uid") or egg.Name
                    if uid and tostring(eUid) == tostring(uid) then
                        candidateEgg = egg
                        break
                    end
                end
            end

            local prompt = candidateEgg and candidateEgg:FindFirstChild("StealPrompt", true)
            if prompt and prompt.Enabled then
                local _, cRoot = getAliveRig()
                if cRoot then
                    local eggPos = candidateEgg:IsA("Model") and candidateEgg:GetPivot().Position or candidateEgg.Position
                    cRoot.CFrame = CFrame.new(eggPos + Vector3.new(0, 3, 0))
                    cRoot.AssemblyLinearVelocity = Vector3.zero
                end
                UniversalCompat.FireProximityPrompt(prompt)
            end
            Services.RunService.Heartbeat:Wait()
        end
        task.wait(0.2)
    end

    -- 3. Enter safe zone with velocity pull & collision disable
    local disabledCollisions = {}
    local groundY = nil
    local deadline = os.clock() + 15.0

    while os.clock() < deadline and session == self.CurrentSession and isHalloweenStealEnabled() and self:IsCarryingEgg() do
        local _, cRoot = getAliveRig()
        local curChar = LocalPlayer.Character
        local curSafe = self:GetSafeZonePart()
        if not cRoot or not curChar or not curSafe then break end

        groundY = groundY or cRoot.Position.Y
        for _, part in ipairs(curChar:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                disabledCollisions[part] = true
                part.CanCollide = false
            end
        end

        local curRel = curSafe.CFrame:PointToObjectSpace(cRoot.Position)
        local inset = isInstant and 6 or 25
        local clampX = math.max(curSafe.Size.X / 2 - inset, 0)
        local clampZ = math.max(curSafe.Size.Z / 2 - inset, 0)
        local targetCenter = curSafe.CFrame:PointToWorldSpace(Vector3.new(
            math.clamp(curRel.X, -clampX, clampX),
            curRel.Y,
            math.clamp(curRel.Z, -clampZ, clampZ)
        ))

        local delta = targetCenter - cRoot.Position
        local horizDelta = Vector3.new(delta.X, 0, delta.Z)
        local targetVel = Vector3.zero
        if horizDelta.Magnitude > 2 then
            targetVel = horizDelta.Unit * math.min(80, horizDelta.Magnitude / 0.05)
        end
        cRoot.AssemblyLinearVelocity = targetVel + Vector3.new(0, (groundY - cRoot.Position.Y) * 8, 0)

        if LocalPlayer:GetAttribute("HalloweenDelivered") ~= initialDelivered then
            break
        end
        Services.RunService.Heartbeat:Wait()
    end

    local _, endRoot = getAliveRig()
    if endRoot then endRoot.AssemblyLinearVelocity = Vector3.zero end
    for part in pairs(disabledCollisions) do
        if part.Parent then part.CanCollide = true end
    end

    if self:IsCarryingEgg() and os.clock() >= deadline then
        self:DropEgg()
    end

    ShieldManager:UnmuteUGI()
    return not self:IsCarryingEgg()
end

function HalloweenStealManager:Process()
    if not isHalloweenStealEnabled() then return end
    if self.IsActive then return end

    if not HalloweenPortalManager.IsInHalloweenDimension() then
        HalloweenPortalManager.EnterDimension(5.0)
        return
    end

    local char, root, hum = getAliveRig()
    if not char or not root or not hum then return end

    self.IsActive = true
    self.CurrentSession = self.CurrentSession + 1
    local session = self.CurrentSession

    if self:IsCarryingEgg() then
        local delivered = self:ExecuteDelivery(session, self.LastGrabbedUid, self.LastGrabbedEgg)
        if delivered and isHalloweenStealPanelTarget() then
            local tUid = State.targetedSpecificUid
            if tUid and State.activeStealButtons[tUid] then
                State.activeStealButtons[tUid].BackgroundColor3 = activeTheme and activeTheme.Accent or Color3.fromRGB(92, 170, 255)
                State.activeStealButtons[tUid].Text = "Steal"
            end
            State.targetedSpecificUid = nil
            State.targetedSpecificIsHalloween = false
            State.targetedSpecificHalloweenEgg = nil
        end
    else
        local targetEgg = self:SelectTargetEgg()
        if targetEgg and targetEgg.Parent then
            local grabbed = self:ApproachAndGrab(targetEgg, session)
            local delivered = false
            if (grabbed or self:IsCarryingEgg()) and session == self.CurrentSession and isHalloweenStealEnabled() then
                delivered = self:ExecuteDelivery(session, self.LastGrabbedUid, targetEgg)
            end

            if isHalloweenStealPanelTarget() and State.targetedSpecificUid == self.LastGrabbedUid and (delivered or not targetEgg.Parent) then
                if State.activeStealButtons[self.LastGrabbedUid] then
                    State.activeStealButtons[self.LastGrabbedUid].BackgroundColor3 = activeTheme and activeTheme.Accent or Color3.fromRGB(92, 170, 255)
                    State.activeStealButtons[self.LastGrabbedUid].Text = "Steal"
                end
                State.targetedSpecificUid = nil
                State.targetedSpecificIsHalloween = false
                State.targetedSpecificHalloweenEgg = nil
            end
        end
    end

    setCollisions(true)
    self.IsActive = false
end

function HalloweenStealManager:Abort()
    self.CurrentSession = self.CurrentSession + 1
    self.IsActive = false
    if self.ActiveTween then
        pcall(function() self.ActiveTween:Cancel() end)
        self.ActiveTween = nil
    end
    ShieldManager:UnmuteUGI()
    setCollisions(true)
    if PriorityManager then PriorityManager:Release("HalloweenSteal") end
    local _, root, hum = getAliveRig()
    if hum then hum.PlatformStand = false end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

