local function executeFastStealDelivery(targetEgg, sessionId)
    local _, root, hum = getAliveRig()
    if not root or not hum then return false end

    local uid = targetEgg.Uid
    local laneZ = math.clamp(root.Position.Z, -425, -300)
    local dropTargetGY = getGroundY(CONFIG.SeparationLineX + CONFIG.FastStealLineDropOffset, laneZ, 74.0)
    local dropTargetPos = Vector3.new(CONFIG.SeparationLineX + CONFIG.FastStealLineDropOffset, dropTargetGY, laneZ)

    hum.PlatformStand = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
    setCollisions(false)
    ShieldManager:MuteUGI()

    local currentX = root.Position.X
    local hopStep = CONFIG.FastStealHopSpeed

    while currentX - hopStep > dropTargetPos.X do
        if sessionId ~= State.currentStealSession or not isStealEnabled() or not isHoldingEgg() then
            hum.PlatformStand = false
            setCollisions(true)
            ShieldManager:UnmuteUGI()
            return false
        end

        currentX = currentX - hopStep
        local _, cRoot, cHum = getAliveRig()
        if not cRoot then break end
        if cHum then cHum.PlatformStand = false end

        local hopGY = getGroundY(currentX, laneZ, CONFIG.GroundAltitude + 2.85)
        cRoot.CFrame = CFrame.new(currentX, hopGY, laneZ) * CFrame.Angles(0, math.rad(90), 0)
        cRoot.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.08)
    end

    local _, cRoot = getAliveRig()
    if cRoot then
        local finalGY = getGroundY(dropTargetPos.X, dropTargetPos.Z, dropTargetPos.Y)
        cRoot.CFrame = CFrame.new(dropTargetPos.X, finalGY, dropTargetPos.Z) * CFrame.Angles(0, math.rad(90), 0)
        cRoot.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.2)

    dropHeldEggDirect()
    local dropWait = os.clock() + 1.2
    while os.clock() < dropWait and isHoldingEgg() do
        Services.RunService.Heartbeat:Wait()
    end

    local droppedEggPos = dropTargetPos

    findMyPlot()
    if State.myTreadmill then
        local _, tRoot = getAliveRig()
        if tRoot then
            tRoot.CFrame = CFrame.new(State.myTreadmill.Position + Vector3.new(0, 1.5, 0))
            tRoot.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.1)

            if Remotes.AskWearStill then pcall(function() Remotes.AskWearStill:InvokeServer() end) end
            local anchorTimeout = os.clock() + 1.5
            while os.clock() < anchorTimeout do
                local _, checkRoot = getAliveRig()
                if checkRoot and checkRoot.Anchored then break end
                Services.RunService.Heartbeat:Wait()
            end

            if Remotes.AskDoff then pcall(function() Remotes.AskDoff:InvokeServer() end) end
            local _, freeRoot, freeHum = getAliveRig()
            if freeRoot then freeRoot.Anchored = false end
            if freeHum then freeHum.PlatformStand = false; freeHum.Sit = false end
            task.wait(0.1)
        end
    end

    local regrabSuccess = false
    local regrabTimeout = os.clock() + 12

    while os.clock() < regrabTimeout do
        if sessionId ~= State.currentStealSession or not isStealEnabled() then break end
        regrabSuccess = instantGrabAtPosition(uid, droppedEggPos, sessionId, false)
        if regrabSuccess and isHoldingEgg() then break end
        task.wait(0.08)
    end

    if not isHoldingEgg() then
        setCollisions(true)
        ShieldManager:UnmuteUGI()
        return false
    end

    local _, fRoot, fHum = getAliveRig()
    if fRoot then
        local baseGY = getGroundY(CONFIG.BaseDropPosition.X, CONFIG.BaseDropPosition.Z, CONFIG.BaseDropPosition.Y + 1.2)
        fRoot.CFrame = CFrame.new(CONFIG.BaseDropPosition.X, baseGY, CONFIG.BaseDropPosition.Z)
        fRoot.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.25)

    if fHum then fHum.PlatformStand = false end

    dropHeldEggDirect()
    task.wait(0.3)
    setCollisions(true)
    ShieldManager:UnmuteUGI()
    return true
end

