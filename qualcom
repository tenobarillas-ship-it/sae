local smoothTw = TweenInfo.new(0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function doTween(obj, info, props) local tw = Services.TweenService:Create(obj, info, props); tw:Play(); return tw end
local function rndCorner(p, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = p; return c end
local function makeGrad(p, r) local g = Instance.new("UIGradient"); g.Rotation = r or 0; g.Parent = p; return g end

local function attachTactileAnimation(btn)
    local origSize = btn.Size
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            doTween(btn, fastTw, {Size = UDim2.new(origSize.X.Scale * 0.94, origSize.X.Offset * 0.94, origSize.Y.Scale * 0.94, origSize.Y.Offset * 0.94)})
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.MouseButton1 then
            doTween(btn, springTw, {Size = origSize})
        end
    end)
end

