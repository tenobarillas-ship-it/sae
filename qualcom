    State.isOpn = true
end

local function closeUi()
    local outTw = doTween(frm, smoothTw, {Size = UDim2.new(0, 0, 0, 0)})
    outTw.Completed:Connect(function() if not State.isOpn then frm.Visible = false end end)
    State.isOpn = false
end

