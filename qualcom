HalloweenPumpkinManager = {
    IsBusy = false,
    PumpkinsDeposited = 0,
    Config = {
        AltarDepositPos = Vector3.new(-5521.6, -195.0, -6623.0),
        Bounds = {
            MinX = -7000.0,
            MaxX = -4900.0,
            MinZ = -7700.0,
            MaxZ = -4800.0
        },
