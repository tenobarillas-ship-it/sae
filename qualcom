        for _, desc in ipairs(Services.ReplicatedStorage:GetDescendants()) do
            if (desc:IsA("RemoteFunction") or desc:IsA("RemoteEvent")) and desc.Name == pathName then
                return desc
            end
        end
    end
    return remote
end

