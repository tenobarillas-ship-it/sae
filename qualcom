    task.delay(0.08, function() doTween(tglBtn, fastTw, {Size = bSz}) end)
    if State.isOpn then closeUi() else openUi() end
end)

local function makeDraggable(handle, target)
    if not handle or not target then return end
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local startPos = target.Position
            local startInputPos = input.Position

            local moveConn
            moveConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.Change then
                    local delta = input.Position - startInputPos
                    target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                elseif input.UserInputState == Enum.UserInputState.End then
                    moveConn:Disconnect()
                end
            end)
        end
    end)
end

makeDraggable(topBar, frm)
makeDraggable(tglBtn, tglBtn)

