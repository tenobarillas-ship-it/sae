    tit.TextXAlignment = Enum.TextXAlignment.Left
    tit.Text = title

    local sub = Instance.new("TextLabel", row)
    sub.Size = UDim2.new(1, -90, 0, 24)
    sub.Position = UDim2.new(0, 10, 0, 24)
    sub.BackgroundTransparency = 1
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 9.5
    sub.TextColor3 = activeTheme.SubText
    sub.TextXAlignment = Enum.TextXAlignment.Left
    sub.Text = desc

    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size = UDim2.new(0, 75, 0, 18)
    valLbl.Position = UDim2.new(1, -85, 0, 6)
    valLbl.BackgroundTransparency = 1
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 12
    valLbl.TextColor3 = activeTheme.Accent
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Text = tostring(defaultVal)

    local trk = Instance.new("Frame", row)
    trk.Size = UDim2.new(0, 80, 0, 6)
    trk.Position = UDim2.new(1, -90, 0.5, 6)
    trk.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    trk.BorderSizePixel = 0
    rndCorner(trk, 3)

    local pct = math.clamp((defaultVal - min) / (max - min), 0, 1)
    local fil = Instance.new("Frame", trk)
    fil.Size = UDim2.new(pct, 0, 1, 0)
    fil.BackgroundColor3 = activeTheme.Accent
    fil.BorderSizePixel = 0
    rndCorner(fil, 3)

    local kn = Instance.new("TextButton", trk)
    kn.Size = UDim2.new(0, 14, 0, 14)
    kn.Position = UDim2.new(pct, -7, 0.5, -7)
    kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    kn.BorderSizePixel = 0
    kn.Text = ""
    rndCorner(kn, 7)

    local function update(inputPos)
        local relX = math.clamp(inputPos.X - trk.AbsolutePosition.X, 0, trk.AbsoluteSize.X)
        local newPct = relX / trk.AbsoluteSize.X
        local rawVal = min + (max - min) * newPct
        local snappedVal = math.floor((rawVal / increment) + 0.5) * increment
        snappedVal = math.clamp(snappedVal, min, max)

        local finalPct = (snappedVal - min) / (max - min)
        fil.Size = UDim2.new(finalPct, 0, 1, 0)
        kn.Position = UDim2.new(finalPct, -7, 0.5, -7)
        valLbl.Text = tostring(snappedVal)
        if callback then callback(snappedVal) end
    end

    trk.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            update(input.Position)
            local moveConn
            moveConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.Change then
                    update(input.Position)
                elseif input.UserInputState == Enum.UserInputState.End then
                    moveConn:Disconnect()
                end
            end)
        end
    end)

    table.insert(State.themeSubscribers, function(th)
        row.BackgroundColor3 = th.RowBg
        rowStr.Color = th.Stroke
        sub.TextColor3 = th.SubText
        valLbl.TextColor3 = th.Accent
        fil.BackgroundColor3 = th.Accent
    end)

    return row
end

