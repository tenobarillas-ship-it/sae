    IsBusy = false,
    LastPlaceAttempt = 0
}

function AutoPlaceEggManager:GetPlayerBackpackEggs()
    local eggs = {}
    if EggState and typeof(EggState.ReadOwnerEggs) == "function" then
        local ok, data = pcall(EggState.ReadOwnerEggs, LocalPlayer.UserId)
        if ok and type(data) == "table" then
            for uid, info in pairs(data) do
                if type(info) == "table" and not info.Placed then
                    info.Uid = uid
                    table.insert(eggs, info)
                end
            end
        end
    end

    if #eggs == 0 then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                local uid = item:GetAttribute("UID")
                if uid then
                    table.insert(eggs, {
                        Uid = uid,
                        AssetCategory = item.Name,
                        Scale = item:GetAttribute("AssetScale") or 1
                    })
                end
            end
        end
    end
    return eggs
end

function AutoPlaceEggManager:Process()
    if not getgenv().config.autoPlaceEgg or State.isStealingActive or isHoldingEgg() then
        self.IsBusy = false
        return
    end

    if os.clock() - self.LastPlaceAttempt < 2.0 then return end
    self.LastPlaceAttempt = os.clock()

    findMyPlot()
    local plot = State.myPlot
    if not plot then return end

    local penSlots = plot:FindFirstChild("EggPenSlots") or plot:FindFirstChild("EggSlots") or plot:FindFirstChild("PenGrid")
    if not penSlots then return end

    local unplacedEggs = self:GetPlayerBackpackEggs()
    if #unplacedEggs == 0 then return end

    local order = getgenv().config.placeOrder or "Highest Value"
    if order == "Highest Value" then
        table.sort(unplacedEggs, function(a, b)
            local valA = (tonumber(a.EarningRate) or 0) * (tonumber(a.Scale) or 1)
            local valB = (tonumber(b.EarningRate) or 0) * (tonumber(b.Scale) or 1)
            return valA > valB
        end)
    elseif order == "Biggest" then
        table.sort(unplacedEggs, function(a, b)
            return (tonumber(a.Scale) or 1) > (tonumber(b.Scale) or 1)
        end)
    end

    for _, slot in ipairs(penSlots:GetChildren()) do
        if not slot:GetAttribute("Occupied") and #unplacedEggs > 0 then
            local egg = table.remove(unplacedEggs, 1)
            if egg and Remotes.AskPlaceEgg then
                pcall(function()
                    Remotes.AskPlaceEgg:InvokeServer({
                        Uid = egg.Uid,
                        LocalCFrame = slot.CFrame
                    })
                end)
                task.wait(0.2)
            end
        end
    end
end

