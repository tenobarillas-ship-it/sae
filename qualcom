function EventEggCaptureManager:Process()
    if not getgenv().config.autoCaptureEventEgg or State.isStealingActive then
        self.IsBusy = false
        return
    end

    local _, root, hum = getAliveRig()
    if not root or not hum then return end

    if self:IsPlayerHoldingEventEgg() then
        self.Holding = true
        self.IsBusy = true
        local safePos = root.Position
        if safePos.Y < 120 then
            root.CFrame = CFrame.new(safePos.X, 130, safePos.Z)
        end
        return
    else
        self.Holding = false
    end

    local egg = self:GetEventEgg()
    if not egg then
        self.IsBusy = false
        return
    end

    self.IsBusy = true
    hopOffTreadmill()

    local eggPos = nil
    if egg:IsA("BasePart") then
        eggPos = egg.Position
    elseif egg:IsA("Model") then
        local ok, pivot = pcall(egg.GetPivot, egg)
        eggPos = ok and pivot.Position or (egg.PrimaryPart and egg.PrimaryPart.Position)
    end

    if eggPos then
        local dist = (root.Position - eggPos).Magnitude
        if dist > 6 then
            local dur = math.clamp(dist / 260, 0.2, 3.0)
            local tw = Services.TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
                CFrame = CFrame.new(eggPos + Vector3.new(0, 2, 0))
            })
            tw:Play()
            tw.Completed:Wait()
        end

        local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.Enabled then
            UniversalCompat.FireProximityPrompt(prompt)
        end
    end

    task.wait(0.2)
    self.IsBusy = false
end

