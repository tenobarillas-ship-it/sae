    end
    return nil
end

function ShootingStarManager:Process()
    if not getgenv().config.autoCatchShootingStar or State.isStealingActive or isHoldingEgg() then
        self.IsBusy = false
        return
    end

    local star = self:GetActiveStar()
    if not star then
        self.IsBusy = false
        return
    end

    local _, root, hum = getAliveRig()
    if not root or not hum then return end

    self.IsBusy = true
    hopOffTreadmill()

    local starPos = nil
    if star:IsA("BasePart") then
        starPos = star.Position
    elseif star:IsA("Model") then
        local ok, pivot = pcall(star.GetPivot, star)
        starPos = ok and pivot.Position or (star.PrimaryPart and star.PrimaryPart.Position)
    end

    if not starPos then
        self.IsBusy = false
        return
    end

    local dist = (root.Position - starPos).Magnitude
    if dist > 8 then
        local tweenDuration = math.clamp(dist / 280, 0.2, 3.5)
        local tw = Services.TweenService:Create(root, TweenInfo.new(tweenDuration, Enum.EasingStyle.Linear), {
            CFrame = CFrame.new(starPos + Vector3.new(0, 3, 0))
        })
        tw:Play()
        tw.Completed:Wait()
    end

    local starId = star:GetAttribute("Id") or star:GetAttribute("UID") or star.Name
    if Remotes.ShootingStarCatch then
        pcall(function() Remotes.ShootingStarCatch:FireServer(starId) end)
    end

    local prompt = star:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled then
        UniversalCompat.FireProximityPrompt(prompt)
    end

    self.StarsCollected = self.StarsCollected + 1
    task.wait(0.3)
    self.IsBusy = false
end

