function CharacterProtection:Init()
    -- 1. Anti-AFK (Disables Roblox 20-minute idle disconnect)
    pcall(function()
        if typeof(getconnections) == "function" then
            for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do
                pcall(function() conn:Disable() end)
            end
        end
        -- Connection-only Anti-AFK (matches ChiliHub, 100% undetected)
    end)

    -- 2. Anti-Trap (Neutralizes enemy & other players' traps via CollectionService)
    local function neutralizeTrap(trap)
        if not trap or not trap.Parent then return end
        local owner = trap:GetAttribute("Owner")
        if owner and tostring(owner) == LocalPlayer.Name then return end -- Keep player's own traps working!

        for _, part in ipairs(trap:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanTouch = false end)
            end
        end
        if trap:IsA("BasePart") then
            pcall(function() trap.CanTouch = false end)
        end
        trap.DescendantAdded:Connect(function(part)
            if part:IsA("BasePart") then
                pcall(function() part.CanTouch = false end)
            end
        end)
    end

    pcall(function()
        for _, trap in ipairs(Services.CollectionService:GetTagged("PlacedTrap")) do
            neutralizeTrap(trap)
        end
        Services.CollectionService:GetInstanceAddedSignal("PlacedTrap"):Connect(function(trap)
            task.defer(neutralizeTrap, trap)
        end)
    end)

    -- 3. Anti-Ragdoll (Instantly recovers character if knocked down by monsters, guards, or bats)
    local ragdollStateTypes = {
        [Enum.HumanoidStateType.Physics] = true,
        [Enum.HumanoidStateType.Ragdoll] = true,
        [Enum.HumanoidStateType.FallingDown] = true
    }
    local ragdollConstraintClasses = {
        BallSocketConstraint = true,
