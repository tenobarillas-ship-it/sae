function BloomManager:GetButterflies()
    local list = {}
    local swarm = Services.Workspace:FindFirstChild("ButterflyBloomSwarm")
    if swarm then
        for _, b in ipairs(swarm:GetChildren()) do
            if b:IsA("Model") or b:IsA("BasePart") then
                table.insert(list, b)
            end
