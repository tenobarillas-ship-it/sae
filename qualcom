    local cLay = Instance.new("UIListLayout", content)
    cLay.Padding = UDim.new(0, 8)
    cLay.SortOrder = Enum.SortOrder.LayoutOrder

    local isOpen = defaultOpen or false

    local function updateSize()
        local targetH = 44 + cLay.AbsoluteContentSize.Y + 16
        if isOpen then
            content.Visible = true
            doTween(frame, smoothTw, {Size = UDim2.new(1, 0, 0, targetH)})
            doTween(arrow, fastTw, {Rotation = 90})
        else
            local tw = doTween(frame, smoothTw, {Size = UDim2.new(1, 0, 0, 44)})
            doTween(arrow, fastTw, {Rotation = 0})
            tw.Completed:Connect(function()
                if not isOpen then content.Visible = false end
            end)
        end
    end

    cLay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if isOpen then
            local targetH = 44 + cLay.AbsoluteContentSize.Y + 16
            doTween(frame, smoothTw, {Size = UDim2.new(1, 0, 0, targetH)})
        end
    end)

    header.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        updateSize()
    end)

    if defaultOpen then
        task.defer(function()
            task.wait(0.08)
            if isOpen then
                local targetH = 44 + cLay.AbsoluteContentSize.Y + 16
                frame.Size = UDim2.new(1, 0, 0, targetH)
            end
        end)
    end

    table.insert(State.themeSubscribers, function(th)
        frame.BackgroundColor3 = th.CardBg
        fStr.Color = th.Stroke
        bar.BackgroundColor3 = th.Accent
        arrow.TextColor3 = th.Accent2
    end)

    return content
end

